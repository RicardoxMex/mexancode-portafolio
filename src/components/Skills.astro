---
import { Image } from "astro:assets";

// Skills Section - Grouped by categories
const skillCategories = [
    {
        category: "Lenguajes",
        icon: "💻",
        technologies: [
            { name: "TypeScript", icon: "/images/skills/typescript.svg" },
            { name: "JavaScript", icon: "/images/skills/javascript.svg" },
            { name: "PHP", icon: "/images/skills/php.svg" },
            { name: "HTML/CSS", icon: "/images/skills/css.svg" },
        ],
    },
    {
        category: "Frameworks",
        icon: "🚀",
        technologies: [
            { name: "React", icon: "/images/skills/react.svg" },
            { name: "React Native", icon: "/images/skills/react.svg" },
            { name: "Laravel", icon: "/images/skills/laravel.svg" },
            { name: "Tailwind CSS", icon: "/images/skills/tailwind.svg" },
        ],
    },
    {
        category: "Bases de Datos",
        icon: "🗄️",
        technologies: [
            { name: "MySQL", icon: "/images/skills/mysql.svg" },
            { name: "PostgreSQL", icon: "/images/skills/postgresql.svg" },
        ],
    },
    {
        category: "Tools",
        icon: "🛠️",
        technologies: [
            { name: "Git", icon: "/images/skills/git.svg" },
            { name: "Docker", icon: "/images/skills/docker.svg" },
            { name: "Epicor ERP", icon: "/images/skills/epicor.svg" },
            { name: "Visual Studio", icon: "/images/skills/visual.svg" },
            { name: "N8N", icon: "/images/skills/n8n.svg" },
        ],
    },
];
---

<section id="skills" class="skills">
    <div class="skills-container">
        <div class="section-header">
            <span class="section-tag">Stack Tecnológico</span>
            <h2 class="section-title">Tecnologías & Herramientas</h2>
            <p class="section-description">
                Experiencia trabajando con tecnologías modernas para desarrollo
                web y móvil
            </p>
        </div>

        <div class="categories-wrapper">
            {
                skillCategories.map((category, categoryIndex) => (
                    <div
                        class="category-section"
                        style={`animation-delay: ${categoryIndex * 0.1}s`}
                    >
                        <div class="category-header">
                            <span class="category-icon">{category.icon}</span>
                            <h3 class="category-title">{category.category}</h3>
                        </div>

                        <div class="tech-grid">
                            {category.technologies.map((tech, techIndex) => (
                                <div
                                    class="tech-item"
                                    style={`animation-delay: ${categoryIndex * 0.1 + techIndex * 0.03}s`}
                                >
                                    <Image
                                        src={tech.icon}
                                        alt={tech.name}
                                        width="50"
                                        height="50"
                                    />
                                    <span class="tech-name">{tech.name}</span>
                                </div>
                            ))}
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>

<style>
    .skills {
        padding: 8rem 2rem;
        background: #ffffff;
        border-top: 1px solid #e5e5e5;
    }

    .skills-container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .section-header {
        text-align: center;
        margin-bottom: 5rem;
    }

    .section-tag {
        font-size: 0.875rem;
        font-weight: 500;
        color: #666666;
        text-transform: uppercase;
        letter-spacing: 2px;
        margin-bottom: 1.5rem;
        display: block;
    }

    .section-title {
        font-size: 2.5rem;
        font-weight: 600;
        color: #1a1a1a;
        line-height: 1.2;
    }

    .section-description {
        font-size: 1.125rem;
        color: #666666;
        max-width: 600px;
        margin: 2rem auto 0;
    }

    .categories-wrapper {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 4rem;
    }

    .category-section {
        opacity: 0;
        animation: fadeInUp 0.6s ease-out forwards;
    }

    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .category-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid #e5e5e5;
    }

    .category-icon {
        font-size: 2rem;
        line-height: 1;
    }

    .category-title {
        font-size: 1.5rem;
        font-weight: 600;
        color: #1a1a1a;
        margin: 0;
    }

    .tech-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 1.5rem;
    }

    .tech-item {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1.5rem 2rem;
        background: linear-gradient(135deg, #fafafa 0%, #ffffff 100%);
        border: 1px solid #e5e5e5;
        border-radius: 16px;
        opacity: 0;
        animation: fadeInScale 0.5s ease-out forwards;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        cursor: default;
        position: relative;
        overflow: hidden;
    }

    .tech-item::before {
        content: "";
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(
            90deg,
            transparent,
            rgba(255, 107, 53, 0.1),
            transparent
        );
        transition: left 0.5s ease;
    }

    .tech-item:hover::before {
        left: 100%;
    }

    .tech-item:hover {
        transform: translateY(-6px) scale(1.02);
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.08);
        border-color: #ff6b35;
        background: linear-gradient(135deg, #ffffff 0%, #fffaf8 100%);
    }

    @keyframes fadeInScale {
        from {
            opacity: 0;
            transform: scale(0.9);
        }
        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    .tech-icon {
        font-size: 1.75rem;
        line-height: 1;
        flex-shrink: 0;
        transition: transform 0.3s ease;
    }

    .tech-item:hover .tech-icon {
        transform: scale(1.2) rotate(5deg);
    }

    .tech-name {
        font-size: 1rem;
        font-weight: 500;
        color: #1a1a1a;
        transition: color 0.3s ease;
    }

    .tech-item:hover .tech-name {
        color: #ff6b35;
    }

    @media (max-width: 968px) {
        .skills {
            padding: 6rem 2rem;
        }

        .section-title {
            font-size: 2rem;
        }

        .categories-wrapper {
            gap: 3rem;
        }

        .category-title {
            font-size: 1.25rem;
        }

        .tech-grid {
            grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
            gap: 1.25rem;
        }

        .tech-item {
            padding: 1.25rem 1.5rem;
        }
    }

    @media (max-width: 640px) {
        .skills {
            padding: 4rem 1.5rem;
        }

        .section-title {
            font-size: 1.75rem;
        }

        .section-description {
            font-size: 1rem;
        }

        .categories-wrapper {
            gap: 2.5rem;
        }

        .category-header {
            gap: 0.75rem;
        }

        .category-icon {
            font-size: 1.5rem;
        }

        .category-title {
            font-size: 1.125rem;
        }

        .tech-item {
            padding: 1rem 1.25rem;
            gap: 0.75rem;
        }

        .tech-icon {
            font-size: 1.5rem;
        }

        .tech-name {
            font-size: 0.9rem;
        }
    }
</style>
